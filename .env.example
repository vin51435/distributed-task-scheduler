# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
SCHEDULER_PORT=3001
SCANNER_PORT=3002
SCANNER_POLLING_INTERVAL_MS=5000
SCANNER_BATCH_SIZE=500
DISPATCHER_PORT=3003
DISPATCHER_POLL_INTERVAL_MS=2000
DISPATCHER_BATCH_SIZE=500
WORKER_PORT=3004
LOG_LEVEL=info

# ==========================================
# PostgreSQL Configuration
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_DB=scheduler_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# ==========================================
# Redis Configuration
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# RabbitMQ Configuration
# ==========================================
RABBITMQ_HOST=localhost
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=scheduler.exchange
RABBITMQ_QUEUE=scheduler.jobs
RABBITMQ_ROUTING_KEY=job.execute

# ==========================================
# Prometheus Configuration
# ==========================================
PROMETHEUS_PORT=9090

# ==========================================
# Grafana Configuration
# ==========================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000

# ==========================================
# Jaeger Configuration
# ==========================================
JAEGER_UI_PORT=16686
