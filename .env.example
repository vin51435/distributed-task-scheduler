# ==============================================================================
# DISTRIBUTED TASK SCHEDULER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
NODE_ENV=development
LOG_LEVEL=info

# ==============================================================================
# Microservices HTTP Ports & Routing
# ==============================================================================
# Public API Gateway (Single client-facing entrypoint)
GATEWAY_PORT=8080

# Internal Identity Microservice (Auth, RBAC, Multi-tenancy, API Keys)
IDENTITY_PORT=3001
IDENTITY_SERVICE_URL=http://localhost:3001

# Internal Scheduler Microservice (Schedule CRUD, Quotas, Batch Ingestion)
SCHEDULER_PORT=3002
SCHEDULER_SERVICE_URL=http://localhost:3002

# Internal Scanner Microservice (Cron & Due-Time Trigger Scanner)
SCANNER_PORT=3003
SCANNER_POLLING_INTERVAL_MS=5000
SCANNER_BATCH_SIZE=500

# Internal Dispatcher Microservice (Atomic Lock & Queue Dispatcher)
DISPATCHER_PORT=3004
DISPATCHER_POLL_INTERVAL_MS=2000
DISPATCHER_BATCH_SIZE=500

# Internal Worker Microservice (Plugin-style Execution Engine)
WORKER_PORT=3005

# ==============================================================================
# Security & JWT Authentication
# ==============================================================================
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=scheduler_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ==============================================================================
# Redis Distributed Cache & Locks & Rate Limiting
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================================
# RabbitMQ Message Broker
# ==============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=scheduler.exchange
RABBITMQ_QUEUE=scheduler.jobs
RABBITMQ_ROUTING_KEY=job.execute

# ==============================================================================
# Observability & Monitoring
# ==============================================================================
# Grafana Web UI Dashboard
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Prometheus Metrics Scraper
PROMETHEUS_PORT=9090

# Jaeger Distributed Tracing UI & OTLP Collector
JAEGER_UI_PORT=16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
