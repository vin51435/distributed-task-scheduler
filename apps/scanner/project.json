{
  "name": "scanner",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/scanner/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/scanner",
        "main": "apps/scanner/src/main.ts",
        "tsConfig": "apps/scanner/tsconfig.app.json",
        "webpackConfig": "apps/scanner/webpack.config.js",
        "sourceMap": true,
        "assets": ["apps/scanner/src/assets"]
      },
      "configurations": {
        "development": {
          "sourceMap": true
        },
        "production": {
          "sourceMap": true
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "scanner:build",
        "port": 9232
      },
      "configurations": {
        "development": {
          "buildTarget": "scanner:build:development"
        },
        "production": {
          "buildTarget": "scanner:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/scanner/jest.config.ts"
      }
    }
  }
}
