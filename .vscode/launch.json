{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug All Microservices (Nx)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "smartStep": true,
      "preLaunchTask": "Start Infrastructure (Docker)",
      "postDebugTask": "Stop Infrastructure (Docker)",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Identity Service",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "identity"],
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Gateway",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "gateway"],
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Scheduler Service",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "scheduler"],
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Worker Service",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "worker"],
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Dispatcher Service",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "dispatcher"],
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "console": "integratedTerminal"
    }
  ]
}
