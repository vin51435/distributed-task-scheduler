{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "title": "Running Jobs",
      "type": "stat",
      "targets": [{ "expr": "worker_running_jobs", "legendFormat": "Running" }]
    },
    {
      "gridPos": { "h": 8, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "title": "Succeeded Jobs",
      "type": "stat",
      "targets": [{ "expr": "sum(worker_success_total)", "legendFormat": "Succeeded" }]
    },
    {
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "title": "Failed Jobs",
      "type": "stat",
      "targets": [{ "expr": "sum(worker_failure_total)", "legendFormat": "Failed" }]
    },
    {
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "title": "Retries Total",
      "type": "stat",
      "targets": [{ "expr": "sum(worker_retry_total)", "legendFormat": "Retries" }]
    },
    {
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "title": "DLQ Total",
      "type": "stat",
      "targets": [{ "expr": "sum(worker_dlq_total)", "legendFormat": "DLQ" }]
    },
    {
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "title": "Execution Duration (p95 ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(worker_execution_duration_bucket[5m])) by (le))",
          "legendFormat": "p95 Duration"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["worker"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "Worker Dashboard",
  "uid": "worker-overview"
}
