{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "rootDir": ".",
    "paths": {
      "@scheduler-platform/auth": ["./packages/auth/src/index.ts"],
      "@scheduler-platform/auth/*": ["./packages/auth/src/*"],
      "@scheduler-platform/config": ["./packages/config/src/index.ts"],
      "@scheduler-platform/config/*": ["./packages/config/src/*"],
      "@scheduler-platform/database": ["./packages/database/src/index.ts"],
      "@scheduler-platform/database/*": ["./packages/database/src/*"],
      "@scheduler-platform/errors": ["./packages/errors/src/index.ts"],
      "@scheduler-platform/errors/*": ["./packages/errors/src/*"],
      "@scheduler-platform/handlers": ["./packages/handlers/src/index.ts"],
      "@scheduler-platform/handlers/*": ["./packages/handlers/src/*"],
      "@scheduler-platform/logger": ["./packages/logger/src/index.ts"],
      "@scheduler-platform/logger/*": ["./packages/logger/src/*"],
      "@scheduler-platform/metrics": ["./packages/metrics/src/index.ts"],
      "@scheduler-platform/metrics/*": ["./packages/metrics/src/*"],
      "@scheduler-platform/rabbitmq": ["./packages/rabbitmq/src/index.ts"],
      "@scheduler-platform/rabbitmq/*": ["./packages/rabbitmq/src/*"],
      "@scheduler-platform/rate-limiter": ["./packages/rate-limiter/src/index.ts"],
      "@scheduler-platform/rate-limiter/*": ["./packages/rate-limiter/src/*"],
      "@scheduler-platform/redis": ["./packages/redis/src/index.ts"],
      "@scheduler-platform/redis/*": ["./packages/redis/src/*"],
      "@scheduler-platform/sdk": ["./packages/sdk/src/index.ts"],
      "@scheduler-platform/sdk/*": ["./packages/sdk/src/*"],
      "@scheduler-platform/telemetry": ["./packages/telemetry/src/index.ts"],
      "@scheduler-platform/telemetry/*": ["./packages/telemetry/src/*"],
      "@scheduler-platform/tenant": ["./packages/tenant/src/index.ts"],
      "@scheduler-platform/tenant/*": ["./packages/tenant/src/*"],
      "@scheduler-platform/testing": ["./packages/testing/src/index.ts"],
      "@scheduler-platform/testing/*": ["./packages/testing/src/*"]
    },
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
