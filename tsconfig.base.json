{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node10",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@scheduler-platform/errors": ["packages/errors/src/index.ts"],
      "@scheduler-platform/errors/*": ["packages/errors/src/*"],
      "@scheduler-platform/config": ["packages/config/src/index.ts"],
      "@scheduler-platform/config/*": ["packages/config/src/*"],
      "@scheduler-platform/logger": ["packages/logger/src/index.ts"],
      "@scheduler-platform/logger/*": ["packages/logger/src/*"],
      "@scheduler-platform/database": ["packages/database/src/index.ts"],
      "@scheduler-platform/database/*": ["packages/database/src/*"],
      "@scheduler-platform/testing": ["packages/testing/src/index.ts"],
      "@scheduler-platform/testing/*": ["packages/testing/src/*"],
      "@scheduler/errors": ["packages/errors/src/index.ts"],
      "@scheduler/errors/*": ["packages/errors/src/*"],
      "@scheduler/config": ["packages/config/src/index.ts"],
      "@scheduler/config/*": ["packages/config/src/*"],
      "@scheduler/logger": ["packages/logger/src/index.ts"],
      "@scheduler/logger/*": ["packages/logger/src/*"],
      "@scheduler/database": ["packages/database/src/index.ts"],
      "@scheduler/database/*": ["packages/database/src/*"],
      "@scheduler/testing": ["packages/testing/src/index.ts"],
      "@scheduler/testing/*": ["packages/testing/src/*"]
    },
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
